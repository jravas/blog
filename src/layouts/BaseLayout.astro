---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  canonical: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  ogImagePath?: string;
  ogImageAlt?: string;
}

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="site-mark" href="/">jravas.dev</a>
        <a href="/about/">about</a>
        <a href="/rss.xml">rss</a>
        <a href="https://github.com/jravas">github</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="meta">
        © {year} Josip Ravas · <a href="/rss.xml">rss</a> · <a href="https://github.com/jravas"
          >github</a
        >
      </p>
      <p class="meta">zero client-side js · built for reading</p>
    </footer>
  </body>
</html>
