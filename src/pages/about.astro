---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = new URL('/about/', Astro.site).href;
---

<BaseLayout
  title="About"
  description="Who I am, what I work on, and how to reach me."
  canonical={canonical}
>
  <h1>About</h1>
  <p>
    I'm Josip Ravas, DevOps &amp; Architecture Lead at
    <a href="https://prototyp.digital">Prototyp</a>. I work on infrastructure, CI/CD, and
    supply-chain security for agentic development — the pipelines, provenance, and guardrails that
    make AI-assisted engineering shippable rather than just fast.
  </p>
  <p>
    The essays here are the primary versions. When a piece is cross-posted elsewhere, the cross-post
    carries a canonical link back to this site.
  </p>
  <p>
    Reach me at <a href="mailto:josip@prototyp.digital">josip@prototyp.digital</a> or find me on
    <a href="https://github.com/jravas">GitHub</a>.
  </p>
</BaseLayout>
