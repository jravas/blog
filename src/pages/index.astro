---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
import { formatDate, getPublishedPosts, readingTime } from '../lib/posts';

const posts = await getPublishedPosts();
const canonical = new URL('/', Astro.site).href;
---

<BaseLayout description={SITE_DESCRIPTION} canonical={canonical}>
  <section class="hero">
    <p class="eyebrow">Josip Ravas · DevOps &amp; Architecture Lead</p>
    <h1>Essays on infrastructure, <em>measured, not marketed.</em></h1>
    <p class="sub">
      CI/CD, provenance, and supply-chain security for agentic development — the pipelines and
      guardrails that make AI-assisted engineering shippable. Everything here is the original;
      anything published elsewhere points back.
    </p>
    <ul class="badges">
      <li><span class="k">client js</span><span class="v v-accent">0 kB</span></li>
      <li><span class="k">analytics</span><span class="v">none</span></li>
      <li><span class="k">fonts</span><span class="v">self-hosted</span></li>
      <li><span class="k">canonical</span><span class="v">origin</span></li>
    </ul>
    <ul class="chips">
      <li><a href="/rss.xml">rss →</a></li>
      <li><a href="https://github.com/jravas">github →</a></li>
      <li><a href="/about/">about →</a></li>
    </ul>
  </section>

  <section>
    <div class="section-label">
      <h2>Writing</h2>
      <span class="count">{posts.length}</span>
      <span class="desc">essays, newest first</span>
    </div>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <span class="tags">
              {post.data.tags.length > 0 ? `${post.data.tags.join(', ')} · ` : ''}
              {readingTime(post.body ?? '')} min
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
