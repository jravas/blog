---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REPO_URL } from '../../consts';
import { formatDate, getPublishedPosts, readingTime } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// This site is the origin of record. The frontmatter override exists only
// for the rare piece that was published elsewhere first.
const canonical = post.data.canonicalURL ?? new URL(`/writing/${post.id}/`, Astro.site).href;
const canonicalDisplay = canonical.replace(/^https?:\/\//, '').replace(/\/$/, '');

// Every edit to a post is public. GitHub holds the per-file commit log;
// `updatedDate` in the frontmatter is the curated signal for edits that
// changed the argument, not just the spelling.
const historyURL = `${REPO_URL}/commits/main/${post.filePath ?? `src/content/blog/${post.id}.md`}`;

const minutes = readingTime(post.body ?? '');
const tags = post.data.tags.length > 0 ? ` · ${post.data.tags.join(', ')}` : '';
const updated = post.data.updatedDate ? ` · updated ${formatDate(post.data.updatedDate)}` : '';
const metaRest = `${tags} · ${minutes} min${updated}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
>
  <article>
    <header class="post-header">
      <p class="meta">
        <span class="crumb">writing / </span><time datetime={post.data.pubDate.toISOString()}
          >{formatDate(post.data.pubDate)}</time
        >{metaRest}
      </p>
      <h1>{post.data.title}</h1>
    </header>
    <Content />
    <footer class="post-end">
      <a href="/">← all essays</a>
      <span class="canon"
        >canonical · {canonicalDisplay} · <a href={historyURL}>edit history ↗</a></span
      >
    </footer>
  </article>
</BaseLayout>
